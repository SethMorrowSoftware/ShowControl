/*
midi.lcb - xTalk Builder (LCB) binding library for realtime MIDI I/O, via the
           midi_shim C layer over RtMidi. Part of ShowControl for OpenXTalk (OXT).

Output is request/response. Input uses RtMidi's internal FIFO plus POLLING: the
script (or the shipped dispatcher) calls midiPoll on a timer and drains the
queue. Nothing here calls back into script from a foreign thread (README 4.2/6).
Because RtMidi buffers and delta-time-stamps every message, message integrity and
timing survive jittery poll cadence; only added latency scales with the interval.

Conventions:
  * Handles are integers (0 = invalid); a stale handle is a harmless no-op.
  * Channels in the public API are 1-based (1..16). Raw MIDI bytes are 0-based
    on the wire; the convenience senders convert.
  * MIDI byte buffers are LiveCode `Data`. A Data does NOT auto-bridge to a
    foreign `Pointer` (it marshals as an MCDataRef), so -- exactly as osc.lcb and
    the xtalk-suite bindings do -- sends pass MCDataGetBytePtr(theData), and the
    drain fills a raw engine block (MCMemoryAllocate) whose written bytes are
    copied back with MCDataCreateWithBytes.
  * No binding RETURNS a C string: the engine free()s a returned ZString, which
    crashes on the shim's static name/error buffers. Names and the last error
    come back through the caller-buffer entry points instead (see shimText).

The foreign handlers bind to the shared library "midi" (built by CMakeLists.txt,
bundled inside the extension under code/<arch>-<platform>/midi.{so,dll,dylib}).
*/

library org.openxtalk.library.midi

use com.livecode.foreign

metadata title is "MIDI for OpenXTalk"
metadata author is "ShowControl contributors"
metadata version is "0.1.0"

-- =====================================================================
-- Foreign bindings to the shim (private)
-- =====================================================================
private foreign handler _abi_version() returns CInt binds to "c:midi>midi_abi_version!cdecl"
private foreign handler _in_count() returns CInt binds to "c:midi>midi_in_count!cdecl"
private foreign handler _out_count() returns CInt binds to "c:midi>midi_out_count!cdecl"
private foreign handler _in_name(in pIndex as CInt, in pOut as optional Pointer, in pCap as CInt) returns CInt binds to "c:midi>midi_in_name!cdecl"
private foreign handler _out_name(in pIndex as CInt, in pOut as optional Pointer, in pCap as CInt) returns CInt binds to "c:midi>midi_out_name!cdecl"
private foreign handler _in_open(in pIndex as CInt) returns CInt binds to "c:midi>midi_in_open!cdecl"
private foreign handler _out_open(in pIndex as CInt) returns CInt binds to "c:midi>midi_out_open!cdecl"
private foreign handler _in_open_virtual(in pName as ZStringUTF8) returns CInt binds to "c:midi>midi_in_open_virtual!cdecl"
private foreign handler _out_open_virtual(in pName as ZStringUTF8) returns CInt binds to "c:midi>midi_out_open_virtual!cdecl"
private foreign handler _close(in pH as CInt) returns nothing binds to "c:midi>midi_close!cdecl"
private foreign handler _in_ignore(in pH as CInt, in pSysex as CInt, in pTime as CInt, in pSense as CInt) returns nothing binds to "c:midi>midi_in_ignore!cdecl"
-- midi_in_drain_bytes (ABI 2) returns the BYTES written, which is what we need to
-- copy exactly the drained records back out of the raw block.
private foreign handler _in_drain_bytes(in pH as CInt, in pOut as Pointer, in pCap as CInt, in pMax as CInt) returns CInt binds to "c:midi>midi_in_drain_bytes!cdecl"
private foreign handler _out_send(in pH as CInt, in pData as optional Pointer, in pLen as CInt) returns CInt binds to "c:midi>midi_out_send!cdecl"
private foreign handler _last_error(in pOut as optional Pointer, in pCap as CInt) returns CInt binds to "c:midi>midi_last_error!cdecl"

-- dlerror() returns libc-owned text: take it as a raw Pointer and COPY it with
-- MCStringCreateWithCString, never as a ZString the engine would free.
private foreign handler _dlopen(in pPath as ZStringNative, in pFlags as CInt) returns optional Pointer binds to "c:>dlopen!cdecl"
private foreign handler _dlerror() returns optional Pointer binds to "c:>dlerror!cdecl"

-- Engine <builtin> helpers (libfoundation/foundation.h). A `<builtin>` handler
-- resolves by its NAME matching the engine symbol, so these carry NO leading `_`.
private foreign handler MCDataGetBytePtr(in pData as Data) returns Pointer binds to "<builtin>"
private foreign handler MCMemoryAllocate(in pSize as UIntSize, out rBlock as Pointer) returns CBool binds to "<builtin>"
private foreign handler MCMemoryDeallocate(in pBlock as Pointer) returns nothing binds to "<builtin>"
private foreign handler MCDataCreateWithBytes(in pBytes as Pointer, in pCount as CUInt, out rData as Data) returns CBool binds to "<builtin>"
private foreign handler MCStringDecode(in pData as Data, in pEncoding as CInt, in pIsExternalRep as CBool, out rString as String) returns CBool binds to "<builtin>"
private foreign handler MCStringCreateWithCString(in pCString as Pointer, out rString as String) returns CBool binds to "<builtin>"

-- =====================================================================
-- Raw buffers (reused -- never rebuilt in the poll hot path).
-- =====================================================================
-- The drain block: allocated ONCE (kDrainCap bytes) and reused every poll. The
-- flag guards the first allocation, so an unset Pointer is never passed.
variable sDrainPtr as Pointer
variable sDrainReady as Boolean
-- A small block for names / the last error, grown on demand. Its capacity (0
-- until the first allocation) doubles as the "is it allocated?" flag.
variable sTextPtr as Pointer
variable sTextCap as Integer

-- Must be >= the C shim's largest single drain record: a 2-byte length prefix, a
-- 65535-byte maximum SysEx payload, and a 4-byte delta = 65541 bytes. A smaller
-- cap lets an inbound message bigger than the buffer get stashed but never
-- re-emitted, permanently wedging the input port. (Allocated just once.)
private constant kDrainCap is 65541

-- LiveCode Builder has no integer-division operator -- 'div' is LiveCode Script
-- only and does not parse in LCB. Compute floor division for non-negative
-- integers: a - (a mod b) is an exact multiple of b, so dividing gives the exact
-- quotient. (Defined before first use.)
private handler intDiv(in pA as Integer, in pB as Integer) returns Integer
   variable tQ as Integer
   put (pA - (pA mod pB)) / pB into tQ
   return tQ
end handler

private handler ensureDrainBuf()
   variable tOk as Boolean
   if sDrainReady is true then
      return
   end if
   put false into tOk
   unsafe
      put MCMemoryAllocate(kDrainCap, sDrainPtr) into tOk
   end unsafe
   if not tOk then
      throw "midi: failed to allocate the drain buffer"
   end if
   put true into sDrainReady
end handler

private handler ensureTextBuf(in pNeed as Integer)
   variable tOk as Boolean
   if sTextCap >= pNeed then
      return
   end if
   if sTextCap > 0 then
      unsafe
         MCMemoryDeallocate(sTextPtr)
      end unsafe
      put 0 into sTextCap
   end if
   put false into tOk
   unsafe
      put MCMemoryAllocate(pNeed, sTextPtr) into tOk
   end unsafe
   if not tOk then
      throw "midi: failed to allocate a text buffer"
   end if
   put pNeed into sTextCap
end handler

-- Which caller-buffer string getter shimText calls (literal, declared before use).
private constant kTxtInName is 1
private constant kTxtOutName is 2
private constant kTxtError is 3

-- Fetch one string through the shim's caller-buffer contract: bytes written
-- (>= 0), or -needed when too small (grow once, retry). Decoded as UTF-8.
private handler shimText(in pWhich as Integer, in pIndex as Integer) returns String
   variable tRc as Integer
   variable tTry as Integer
   variable tNeed as Integer
   variable tData as Data
   variable tStr as String
   variable tOk as Boolean
   put 256 into tNeed
   put the empty string into tStr
   repeat with tTry from 1 up to 2
      ensureTextBuf(tNeed)
      unsafe
         if pWhich is kTxtInName then
            put _in_name(pIndex, sTextPtr, sTextCap) into tRc
         else if pWhich is kTxtOutName then
            put _out_name(pIndex, sTextPtr, sTextCap) into tRc
         else
            put _last_error(sTextPtr, sTextCap) into tRc
         end if
      end unsafe
      if tRc is 0 then
         return tStr
      end if
      if tRc > 0 then
         unsafe
            put MCDataCreateWithBytes(sTextPtr, tRc, tData) into tOk
         end unsafe
         if not tOk then
            return the empty string
         end if
         unsafe
            put MCStringDecode(tData, 4, false, tStr) into tOk
         end unsafe
         if not tOk then
            return the empty string
         end if
         return tStr
      end if
      if -tRc <= sTextCap then
         return the empty string
      end if
      put -tRc into tNeed
   end repeat
   return the empty string
end handler

-- =====================================================================
-- ABI guard
-- =====================================================================
public handler midiVersion() returns Integer
   variable tR as Integer
   unsafe
      put _abi_version() into tR
   end unsafe
   return tR
end handler

private handler checkABI()
   variable tV as Integer
   unsafe
      put _abi_version() into tV
   end unsafe
   if tV is not 2 then
      throw "midi: incompatible native library ABI (binding needs ABI 2) - rebuild/repackage the midi shim"
   end if
end handler

-- =====================================================================
-- Enumeration
-- =====================================================================
public handler midiInputPorts() returns List
   checkABI()
   variable tCount as Integer
   unsafe
      put _in_count() into tCount
   end unsafe
   variable tList as List
   put [] into tList
   variable i as Integer
   if tCount > 0 then
      repeat with i from 0 up to tCount - 1
         push shimText(kTxtInName, i) onto tList
      end repeat
   end if
   return tList
end handler

public handler midiOutputPorts() returns List
   checkABI()
   variable tCount as Integer
   unsafe
      put _out_count() into tCount
   end unsafe
   variable tList as List
   put [] into tList
   variable i as Integer
   if tCount > 0 then
      repeat with i from 0 up to tCount - 1
         push shimText(kTxtOutName, i) onto tList
      end repeat
   end if
   return tList
end handler

-- =====================================================================
-- Open / close
-- =====================================================================
public handler midiOpenInput(in pIndex as Integer) returns Integer
   checkABI()
   variable tH as Integer
   unsafe
      put _in_open(pIndex) into tH
   end unsafe
   return tH
end handler

public handler midiOpenOutput(in pIndex as Integer) returns Integer
   checkABI()
   variable tH as Integer
   unsafe
      put _out_open(pIndex) into tH
   end unsafe
   return tH
end handler

public handler midiOpenVirtualInput(in pName as String) returns Integer
   checkABI()
   variable tH as Integer
   unsafe
      put _in_open_virtual(pName) into tH
   end unsafe
   return tH
end handler

public handler midiOpenVirtualOutput(in pName as String) returns Integer
   checkABI()
   variable tH as Integer
   unsafe
      put _out_open_virtual(pName) into tH
   end unsafe
   return tH
end handler

public handler midiClose(in pHandle as Integer)
   unsafe
      _close(pHandle)
   end unsafe
end handler

public handler midiIgnoreTypes(in pHandle as Integer, in pSysex as Boolean, in pTime as Boolean, in pSense as Boolean)
   unsafe
      _in_ignore(pHandle, bi(pSysex), bi(pTime), bi(pSense))
   end unsafe
end handler

private handler bi(in pB as Boolean) returns Integer
   if pB then
      return 1
   end if
   return 0
end handler

-- Clamp a value into a single MIDI data byte (0..127). Installations feed junk
-- from sliders / fields / incoming data; a data byte with the high bit set is
-- illegal MIDI and desyncs any receiver, and numToByte of an out-of-range value
-- has engine-dependent behaviour. Clamp so the convenience API is junk-proof.
private handler clamp7(in pV as Integer) returns Integer
   if pV < 0 then
      return 0
   end if
   if pV > 127 then
      return 127
   end if
   return pV
end handler

-- Map a 1..16 channel to its 0..15 status-byte nibble, normalizing out-of-range.
-- LCB mod follows the dividend's sign, so a bare (pChannel - 1) mod 16 goes
-- negative for pChannel <= 0 and would corrupt the status byte.
private handler chanNib(in pChannel as Integer) returns Integer
   return (((pChannel - 1) mod 16) + 16) mod 16
end handler

-- =====================================================================
-- Sending: raw + convenience
-- =====================================================================
public handler midiSend(in pHandle as Integer, in pBytes as Data)
   variable tPtr as Pointer
   if the number of bytes in pBytes is 0 then
      return                     -- nothing to send (the shim would reject len 0)
   end if
   unsafe
      put MCDataGetBytePtr(pBytes) into tPtr
      _out_send(pHandle, tPtr, the number of bytes in pBytes)
   end unsafe
end handler

-- Pack up to three bytes into Data and send.
private handler send3(in pHandle as Integer, in pStatus as Integer, in pD1 as Integer, in pD2 as Integer, in pLen as Integer)
   variable tMsg as Data
   put the byte with code (pStatus) into tMsg
   if pLen >= 2 then
      put the byte with code (clamp7(pD1)) after tMsg
   end if
   if pLen >= 3 then
      put the byte with code (clamp7(pD2)) after tMsg
   end if
   midiSend(pHandle, tMsg)
end handler

public handler midiNoteOn(in pHandle as Integer, in pChannel as Integer, in pNote as Integer, in pVelocity as Integer)
   send3(pHandle, 144 + chanNib(pChannel), pNote, pVelocity, 3)
end handler

public handler midiNoteOff(in pHandle as Integer, in pChannel as Integer, in pNote as Integer, in pVelocity as Integer)
   send3(pHandle, 128 + chanNib(pChannel), pNote, pVelocity, 3)
end handler

public handler midiControlChange(in pHandle as Integer, in pChannel as Integer, in pController as Integer, in pValue as Integer)
   send3(pHandle, 176 + chanNib(pChannel), pController, pValue, 3)
end handler

public handler midiProgramChange(in pHandle as Integer, in pChannel as Integer, in pProgram as Integer)
   send3(pHandle, 192 + chanNib(pChannel), pProgram, 0, 2)
end handler

public handler midiChannelPressure(in pHandle as Integer, in pChannel as Integer, in pValue as Integer)
   send3(pHandle, 208 + chanNib(pChannel), pValue, 0, 2)
end handler

-- 14-bit pitch bend, 0..16383 (8192 = centre).
public handler midiPitchBend(in pHandle as Integer, in pChannel as Integer, in pValue14bit as Integer)
   -- Clamp to the 14-bit range first; otherwise a negative or >16383 value makes
   -- the mod / intDiv below produce out-of-range (or negative) data bytes.
   variable tVal as Integer
   put pValue14bit into tVal
   if tVal < 0 then
      put 0 into tVal
   end if
   if tVal > 16383 then
      put 16383 into tVal
   end if
   variable tLsb as Integer
   variable tMsb as Integer
   put tVal mod 128 into tLsb
   put intDiv(tVal, 128) mod 128 into tMsb
   send3(pHandle, 224 + chanNib(pChannel), tLsb, tMsb, 3)
end handler

-- =====================================================================
-- Receiving: poll + decode
-- =====================================================================
-- midiPoll(pHandle) -> List of records, each:
--   ["delta": <seconds>, "bytes": <Data>, "kind": "noteOn",
--    "channel": 1, "data1": 60, "data2": 100]
public handler midiPoll(in pHandle as Integer) returns List
   variable tBytes as Integer
   variable tDrain as Data
   variable tOk as Boolean
   variable tEvents as List
   variable tPos as Integer
   variable tLen as Integer
   variable tMsg as Data
   variable tDeltaUs as Integer
   put [] into tEvents
   ensureDrainBuf()
   unsafe
      put _in_drain_bytes(pHandle, sDrainPtr, kDrainCap, 256) into tBytes
   end unsafe
   if tBytes <= 0 then
      return tEvents
   end if
   -- Copy exactly the drained bytes out of the raw block (ONE copy per poll, of
   -- only what was written -- not the whole 64 KB block).
   unsafe
      put MCDataCreateWithBytes(sDrainPtr, tBytes, tDrain) into tOk
   end unsafe
   if not tOk then
      return tEvents
   end if
   -- Walk the self-delimiting records, never past the bytes the shim wrote:
   -- [2 bytes len BE][len bytes message][4 bytes delta micros BE]
   put 1 into tPos          -- 1-based byte index into tDrain
   repeat while tPos + 5 <= tBytes
      put the code of (byte tPos of tDrain) * 256 + the code of (byte (tPos + 1) of tDrain) into tLen
      put tPos + 2 into tPos
      if tPos + tLen + 3 > tBytes then
         exit repeat        -- truncated record: cannot happen with a well-behaved shim
      end if
      if tLen > 0 then
         put byte tPos to (tPos + tLen - 1) of tDrain into tMsg
      else
         put the empty data into tMsg
      end if
      put tPos + tLen into tPos
      put the code of (byte tPos of tDrain) * 16777216 \
        + the code of (byte (tPos + 1) of tDrain) * 65536 \
        + the code of (byte (tPos + 2) of tDrain) * 256 \
        + the code of (byte (tPos + 3) of tDrain) into tDeltaUs
      put tPos + 4 into tPos
      push decodeEvent(tMsg, tDeltaUs) onto tEvents
   end repeat
   return tEvents
end handler

-- midiDecode(pBytes) -> Array
--   Decode one raw MIDI message (Data) into the SAME semantic record midiPoll
--   produces -- ["kind", "channel", "data1", "data2", "value14", "bytes", "delta"]
--   -- with delta 0. Useful for decoding MIDI that arrives from somewhere other
--   than a polled input (a file, a Web-MIDI bridge, a test harness), and it makes
--   the decode logic verifiable with NO MIDI hardware at all (drive it with
--   synthetic bytes and assert the result -- see examples/selftest.livecodescript).
public handler midiDecode(in pBytes as Data) returns Array
   return decodeEvent(pBytes, 0)
end handler

-- Decode a raw MIDI message + delta into a semantic record.
private handler decodeEvent(in pBytes as Data, in pDeltaUs as Integer) returns Array
   variable tRec as Array
   put (pDeltaUs / 1000000) into tRec["delta"]
   put pBytes into tRec["bytes"]
   variable tN as Integer
   put the number of bytes in pBytes into tN
   if tN is 0 then
      put "empty" into tRec["kind"]
      return tRec
   end if
   variable tStatus as Integer
   put the code of (byte 1 of pBytes) into tStatus
   variable tD1 as Integer
   variable tD2 as Integer
   put 0 into tD1
   put 0 into tD2
   if tN >= 2 then
      put the code of (byte 2 of pBytes) into tD1
   end if
   if tN >= 3 then
      put the code of (byte 3 of pBytes) into tD2
   end if
   put tD1 into tRec["data1"]
   put tD2 into tRec["data2"]
   if tStatus >= 240 then
      -- system messages (0xF0..0xFF); SysEx etc.
      put 0 into tRec["channel"]
      if tStatus is 240 then
         put "sysex" into tRec["kind"]
      else
         put "system" into tRec["kind"]
      end if
      return tRec
   end if
   variable tType as Integer
   put tStatus - (tStatus mod 16) into tType    -- high nibble
   put (tStatus mod 16) + 1 into tRec["channel"]
   if tType is 144 then
      if tD2 is 0 then
         put "noteOff" into tRec["kind"]      -- note-on velocity 0 == note-off
      else
         put "noteOn" into tRec["kind"]
      end if
   else if tType is 128 then
      put "noteOff" into tRec["kind"]
   else if tType is 176 then
      put "controlChange" into tRec["kind"]
   else if tType is 192 then
      put "programChange" into tRec["kind"]
   else if tType is 224 then
      put "pitchBend" into tRec["kind"]
      put tD1 + tD2 * 128 into tRec["value14"]
   else if tType is 208 then
      put "channelPressure" into tRec["kind"]
   else if tType is 160 then
      put "polyAftertouch" into tRec["kind"]
   else
      put "other" into tRec["kind"]
   end if
   return tRec
end handler

-- =====================================================================
-- Diagnostics + loader
-- =====================================================================
public handler midiLastError() returns String
   return shimText(kTxtError, 0)
end handler

public handler midiLoadNativeLib(in pPath as String) returns Integer
   variable tHandle as optional Pointer
   unsafe
      put _dlopen(pPath, 258) into tHandle
   end unsafe
   if tHandle is nothing then
      return 0
   end if
   return 1
end handler

public handler midiLoadNativeLibError() returns String
   variable tPtr as optional Pointer
   variable tErr as String
   variable tOk as Boolean
   unsafe
      put _dlerror() into tPtr
   end unsafe
   if tPtr is nothing then
      return ""
   end if
   unsafe
      put MCStringCreateWithCString(tPtr, tErr) into tOk
   end unsafe
   if not tOk then
      return ""
   end if
   return tErr
end handler

end library
