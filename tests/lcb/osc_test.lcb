/*
osc_test.lcb - headless behavioural tests for the OSC binding, through the REAL
osc shim (lc-run loads the freshly built osc library).

Byte-exact encodings are pinned by the shared vectors (tests/vectors/osc.json ->
the generated vectors module). This file covers what vectors cannot: the
FFI marshalling itself (Data in, Data out, strings out -- every path that once
crashed or threw), value-type coercion at the Script->LCB boundary, long values
that force the caller-buffer grow path, error reporting, nested structure, and
handle-table churn.
*/
-- requires: osc

module org.openxtalk.showcontrol.tests.osc

use com.livecode.unittest
use org.openxtalk.library.osc
use org.openxtalk.showcontrol.tests.support

public handler TestAbi()
   test "oscVersion is ABI 2" when oscVersion() is 2
end handler

-- The regression that started this suite: a Data passed straight to a foreign
-- Pointer threw "Value is not of correct type", and a returned ZString crashed
-- the VM. Build -> parse -> every string getter, end to end.
public handler TestMarshallingRoundTrip()
   variable tData as Data
   variable tMsg as Array
   variable tArgs as List
   put oscBuildMessage("/marshal", ["s", "out", "b", HexToData("00ff7f80")]) into tData
   test "build returns bytes (Data -> raw block -> Data)" when the number of bytes in tData is 28
   put oscParse(tData) into tMsg
   test "parse address (caller-buffer string)" when tMsg["address"] is "/marshal"
   test "parse types (caller-buffer string)" when tMsg["types"] is "sb"
   put tMsg["args"] into tArgs
   test "string arg (caller-buffer string)" when tArgs[1] is "out"
   test "blob arg with 00 and ff bytes (raw block -> Data)" when DataToHex(tArgs[2]) is "00ff7f80"
   test "oscLastError is empty after success (no crash)" when oscLastError() is ""
end handler

-- The engine hands script values across as Numbers OR Strings. Both must build
-- identical bytes (the binding normalizes with `is a number` / `formatted as`).
public handler TestNumbersAndStringsBuildTheSame()
   test "int: Number == String" when \
      DataToHex(oscBuildMessage("/n", ["i", -42])) is DataToHex(oscBuildMessage("/n", ["i", "-42"]))
   test "float: Number == String" when \
      DataToHex(oscBuildMessage("/n", ["f", 0.5])) is DataToHex(oscBuildMessage("/n", ["f", "0.5"]))
   test "double: Number == String" when \
      DataToHex(oscBuildMessage("/n", ["d", 3.25])) is DataToHex(oscBuildMessage("/n", ["d", "3.25"]))
   test "string arg given a Number is stringified" when \
      DataToHex(oscBuildMessage("/n", ["s", 7])) is DataToHex(oscBuildMessage("/n", ["s", "7"]))
   test "int64 from a small Number" when \
      DataToHex(oscBuildMessage("/n", ["h", 12345])) is DataToHex(oscBuildMessage("/n", ["h", "12345"]))
end handler

-- Values the build must refuse -- quietly (empty Data), never a throw.
public handler TestBadArgsFailQuietly()
   test "unknown type code builds nothing" when the number of bytes in oscBuildMessage("/x", ["x", "1"]) is 0
   test "blob given a String builds nothing" when the number of bytes in oscBuildMessage("/x", ["b", "not data"]) is 0
   test "numeric given an Array builds nothing" when the number of bytes in oscBuildMessage("/x", ["i", ["k"]]) is 0
   test "numeric given a Boolean builds nothing" when the number of bytes in oscBuildMessage("/x", ["i", true]) is 0
   test "a good build after a bad one still works" when the number of bytes in oscBuildMessage("/x", ["i", "1"]) is 12
end handler

-- No-value types may be passed with an empty value OR left dangling at the end.
public handler TestNoValueTypes()
   variable tMsg as Array
   put oscParse(oscBuildMessage("/flags", ["T", "", "F", "", "N", "", "I", ""])) into tMsg
   test "TFNI with empty values" when tMsg["types"] is "TFNI"
   put oscParse(oscBuildMessage("/flags", ["i", "1", "T"])) into tMsg
   test "a trailing no-value type needs no value" when tMsg["types"] is "iT"
   test "a trailing VALUE type with no value builds nothing" when \
      the number of bytes in oscBuildMessage("/x", ["i", "1", "f"]) is 0
end handler

-- Strings longer than the binding's first 256-byte read force the -needed /
-- grow / retry path in every string getter.
public handler TestLongValuesGrowTheBuffer()
   variable tAddr as String
   variable tLong as String
   variable tMsg as Array
   variable tArgs as List
   put "/" & RepeatChar("a", 700) into tAddr
   put RepeatChar("z", 5000) into tLong
   put oscParse(oscBuildMessage(tAddr, ["s", tLong])) into tMsg
   test "701-char address survives" when tMsg["address"] is tAddr
   put tMsg["args"] into tArgs
   test "5000-char string arg survives" when tArgs[1] is tLong
   put oscParse(oscBuildMessage("/blob", ["b", RepeatByte(171, 70000)])) into tMsg
   put tMsg["args"] into tArgs
   test "70000-byte blob survives" when the number of bytes in tArgs[1] is 70000
   test "70000-byte blob content" when tArgs[1] is RepeatByte(171, 70000)
end handler

-- UTF-8 end to end: String -> ZStringUTF8 -> wire bytes -> caller buffer -> String.
public handler TestUtf8()
   variable tCafe as String
   variable tData as Data
   variable tMsg as Array
   variable tArgs as List
   put "caf" & (the char with code (233)) into tCafe     -- e-acute, U+00E9
   put oscBuildMessage("/u", ["s", tCafe]) into tData
   test "UTF-8 encodes e-acute as c3 a9" when DataToHex(tData) contains "636166c3a9"
   put oscParse(tData) into tMsg
   put tMsg["args"] into tArgs
   test "UTF-8 string round-trips" when tArgs[1] is tCafe
   put oscParse(oscBuildMessage("/" & tCafe, [])) into tMsg
   test "UTF-8 address round-trips" when tMsg["address"] is "/" & tCafe
end handler

public handler TestNumericExtremes()
   variable tMsg as Array
   variable tArgs as List
   put oscParse(oscBuildMessage("/x", ["i", "2147483647", "i", "-2147483648", "h", "9223372036854775807", "h", "-9223372036854775808", "t", "18446744073709551615"])) into tMsg
   put tMsg["args"] into tArgs
   test "int32 max" when tArgs[1] is 2147483647
   test "int32 min" when tArgs[2] is -2147483648
   test "int64 max survives as a decimal string" when tArgs[3] is "9223372036854775807"
   test "int64 min survives as a decimal string" when tArgs[4] is "-9223372036854775808"
   test "timetag max is UNSIGNED" when tArgs[5] is "18446744073709551615"
   put oscParse(oscBuildMessage("/x", ["d", "3.141592653589793"])) into tMsg
   put tMsg["args"] into tArgs
   test "double keeps full precision" when NearlyEqual(tArgs[1], 3.141592653589793, 0.000000000000001)
end handler

public handler TestBundles()
   variable tA as Data
   variable tB as Data
   variable tInner as Data
   variable tOuter as Data
   variable tP as Array
   variable tMsgs as List
   variable tSub as Array
   put oscBuildMessage("/a", ["i", "1"]) into tA
   put oscBuildMessage("/b", ["f", "2"]) into tB
   put oscParse(oscBuildBundle("1", [tA, tB])) into tP
   test "bundle parses" when tP["isBundle"] is true
   test "bundle timetag" when tP["timetag"] is "1"
   put tP["messages"] into tMsgs
   test "bundle has 2 messages" when the number of elements in tMsgs is 2
   put tMsgs[1] into tSub
   test "message 1 address" when tSub["address"] is "/a"
   put tMsgs[2] into tSub
   test "message 2 address" when tSub["address"] is "/b"
   -- nesting is preserved, not flattened
   put oscBuildBundle("7", [tA]) into tInner
   put oscBuildBundle("16045690984503098046", [tInner, tB]) into tOuter
   put oscParse(tOuter) into tP
   test "outer timetag (top bit set) is unsigned" when tP["timetag"] is "16045690984503098046"
   put tP["messages"] into tMsgs
   put tMsgs[1] into tSub
   test "first element is itself a bundle" when tSub["isBundle"] is true
   test "inner timetag" when tSub["timetag"] is "7"
   put tMsgs[2] into tSub
   test "second element is a message" when tSub["isBundle"] is false and tSub["address"] is "/b"
   -- an empty bundle is legal
   put oscParse(oscBuildBundle("1", [])) into tP
   test "empty bundle parses with 0 messages" when tP["isBundle"] is true and the number of elements in tP["messages"] is 0
   -- a non-Data element fails the whole bundle quietly
   test "a String element builds nothing" when the number of bytes in oscBuildBundle("1", [tA, "oops"]) is 0
end handler

public handler TestParseErrors()
   variable tP as Array
   put oscParse(the empty data) into tP
   test "empty datagram: no address" when tP["address"] is ""
   test "empty datagram: error reported" when tP["error"] is not ""
   test "empty datagram: oscLastError agrees" when oscLastError() is tP["error"]
   put oscParse(HexToData("61626300" & "2c000000")) into tP
   test "no leading slash is an error" when tP["error"] contains "/"
   put oscParse(oscBuildMessage("/ok", [])) into tP
   test "a good parse clears oscLastError" when oscLastError() is ""
end handler

-- Handle tables must recycle cleanly: thousands of build/parse cycles, each
-- freeing its handles, never exhaust or corrupt anything.
public handler TestHandleChurn()
   variable i as Integer
   variable tOk as Boolean
   variable tP as Array
   put true into tOk
   repeat with i from 1 up to 3000
      put oscParse(oscBuildMessage("/churn", ["i", i])) into tP
      if tP["address"] is not "/churn" then
         put false into tOk
      end if
   end repeat
   test "3000 build/parse cycles stay correct" when tOk
   put oscParse(oscBuildMessage("/after", ["i", "5"])) into tP
   test "still healthy after the churn" when tP["address"] is "/after"
end handler

public handler TestMatchEdgeCases()
   test "pattern equals address" when oscMatch("/a/b", "/a/b")
   test "empty pattern matches only empty" when oscMatch("", "") and not oscMatch("", "/a")
   -- the ReDoS guard: a pathological many-star pattern answers (false) quickly
   test "pathological star pattern terminates" when not oscMatch("/*a*a*a*a*a*a*a*a*a*a*a*b", "/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
end handler


-- Park-Miller minimal standard PRNG: deterministic (same seed, same bytes, so a
-- failure always reproduces) and exact in LCB's double-backed numbers
-- (48271 * (2^31 - 1) < 2^53).
variable sRng as Number

private handler nextRand() returns Number
   put (sRng * 48271) mod 2147483647 into sRng
   return sRng
end handler

private handler randBytes(in pCount as Integer) returns Data
   variable tOut as Data
   variable i as Integer
   put the empty data into tOut
   repeat with i from 1 up to pCount
      put the byte with code (nextRand() mod 256) after tOut
   end repeat
   return tOut
end handler

-- Mutate pSeed: overwrite a few random bytes, sometimes truncate.
private handler mutateBytes(in pSeed as Data) returns Data
   variable tOut as Data
   variable tN as Integer
   variable k as Integer
   variable tPos as Integer
   put pSeed into tOut
   put the number of bytes in tOut into tN
   if tN is 0 then
      return randBytes(nextRand() mod 64)
   end if
   repeat with k from 1 up to 1 + (nextRand() mod 4)
      put 1 + (nextRand() mod tN) into tPos
      put the byte with code (nextRand() mod 256) into byte tPos of tOut
   end repeat
   if nextRand() mod 4 is 0 then
      put byte 1 to (1 + (nextRand() mod tN)) of tOut into tOut
   end if
   return tOut
end handler

-- Property: random and mutated datagrams through the REAL binding never throw
-- and never crash the VM; every result is either a parsed message/bundle or a
-- clean error. (The C fuzzer hammers the shim; this proves the binding's
-- marshalling and string/blob readback hold up on the same garbage.)
public handler TestFuzzParseNeverThrows()
   variable i as Integer
   variable tSeed as Data
   variable tPkt as Data
   variable tP as Array
   variable tOk as Boolean
   variable tParsed as Integer
   put 20261006 into sRng
   put oscBuildMessage("/fuzz/seed", ["i", "1", "s", "abc", "b", HexToData("0102030405"), "d", "2.5", "T", ""]) into tSeed
   put true into tOk
   put 0 into tParsed
   repeat with i from 1 up to 1500
      if i mod 3 is 0 then
         put randBytes(nextRand() mod 96) into tPkt
      else
         put mutateBytes(tSeed) into tPkt
      end if
      put oscParse(tPkt) into tP
      if tP["isBundle"] is false and tP["address"] is "" then
         if tP["error"] is "" then
            put false into tOk         -- rejected but no reason: a contract break
         end if
      else
         add 1 to tParsed
      end if
   end repeat
   test "1500 hostile datagrams: every one parsed or cleanly rejected" when tOk
   test diagnostic (tParsed formatted as string) & " of 1500 parsed"
end handler

end module
